@page "/calculator"
@using MyCalculatorBlazor.Data

<h3>Calculator</h3>

<div class="calculator-container">
   <div class="display">
       <input class="history-display" @bind="History" readonly />
       <input class="main-display" @bind="Display" readonly />
   </div>
   <table class="buttons">
       <tr>
            <td><button @onclick="ClearEntry">CE</button></td>
            <td><button @onclick="Clear">C</button></td>
            <td><button @onclick="Backspace">>>></button></td>
            <td><button @onclick='() => Operation("+")'>+</button></td>
       </tr>
       <tr>
            <td><button @onclick='() => AppendNumber("7")'>7</button></td>
            <td><button @onclick='() => AppendNumber("8")'>8</button></td>
            <td><button @onclick='() => AppendNumber("9")'>9</button></td>
            <td><button @onclick='() => Operation("-")'>-</button></td>
       </tr>
        <tr>
            <td><button @onclick='() => AppendNumber("4")'>4</button></td>
            <td><button @onclick='() => AppendNumber("5")'>5</button></td>
            <td><button @onclick='() => AppendNumber("6")'>6</button></td>
            <td><button @onclick='() => Operation("*")'>*</button></td>
        </tr>
        <tr>
            <td><button @onclick='() => AppendNumber("1")'>1</button></td>
            <td><button @onclick='() => AppendNumber("2")'>2</button></td>
            <td><button @onclick='() => AppendNumber("3")'>3</button></td>
            <td><button @onclick='() => Operation("/")'>/</button></td>
        </tr>
        <tr>
            <td><button @onclick="ToggleSign">+/-</button></td>
            <td><button @onclick='() => AppendNumber("0")'>0</button></td>
            <td><button @onclick='() => AppendNumber(".")'>.</button></td>
            <td><button @onclick="Calculate">=</button></td>
       </tr>
   </table>
</div>

@code {
   private string Display { get; set; } = "0";
   private string History { get; set; } = "";
   private double? number1 = null;
   private double? number2 = null;
   private string? chosenOperator = null;

   private void AppendNumber(string number)
   {
       if (Display == "0" && number != ".")
       {
           Display = number;
       }
       else
       {
           Display += number;
       }
   }

   private void ClearEntry()
   {
       Display = "0";
   }

   private void Clear()
   {
       Display = "0";
       History = "";
       number1 = null;
       number2 = null;
       chosenOperator = null;
   }

   private void Backspace()
   {
       Display = ButtonActions.DeleteText(Display);
   }

   private void ToggleSign()
   {
       Display = Calculations.Revese(double.Parse(Display));
   }

   private void Operation(string operation)
   {
       if (number1 == null)
       {
           number1 = double.Parse(Display);
           chosenOperator = operation;
           History = Display + " " + operation;
           Display = "0";
       }
       else
       {
           number2 = double.Parse(Display);
           number1 = Calculations.CalculateSwitch((double)number1, (double)number2, chosenOperator);
           chosenOperator = operation;
           History = number1 + " " + operation;
           Display = "0";
       }
   }

   private void Calculate()
   {
       if (number1 != null && chosenOperator != null)
       {
           number2 = double.Parse(Display);
           Display = Calculations.CalculateSwitch((double)number1, (double)number2, chosenOperator).ToString();
           History = "";
           number1 = null;
           number2 = null;
           chosenOperator = null;
       }
   }
}